@namespace eShop.WebAppComponents.Item
@using eShop.WebAppComponents.Item

<div class="reviews-summary">
    @if (Summary is not null && Summary.TotalReviews > 0)
    {
        <div class="overall-rating">
            <div class="rating-display">
                <StarRating Rating="@Summary.AverageRating" ShowRatingText="true" CssClass="large" />
                <span class="review-count">Based on @Summary.TotalReviews review@(Summary.TotalReviews == 1 ? "" : "s")</span>
            </div>
        </div>
        
        <div class="rating-breakdown">
            @for (int stars = 5; stars >= 1; stars--)
            {
                int starIndex = stars - 1;
                int count = Summary.RatingCounts.Length > starIndex ? Summary.RatingCounts[starIndex] : 0;
                double percentage = Summary.TotalReviews > 0 ? (double)count / Summary.TotalReviews * 100 : 0;
                
                <div class="rating-bar">
                    <span class="stars-label">@stars ★</span>
                    <div class="bar-container">
                        <div class="bar-fill" style="width: @percentage%"></div>
                    </div>
                    <span class="count">@count</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-rating">
            <p>No ratings yet</p>
        </div>
    }
</div>

@code {
    [Parameter] public ProductRatingsSummary? Summary { get; set; }
}